// Kurzes fastfetch wie im Foto: kleines Arch-Logo, sieben Zeilen, Schwarz-Weiss.
// Starten: fastfetch -c rice
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch_small",
        "color": { "1": "white", "2": "white" },
        "padding": { "left": 1, "right": 3 }
    },
    "display": {
        "separator": " ",
        "color": { "keys": "90", "title": "bright_white" }
    },
    "modules": [
        { "type": "title", "format": "{user-name}@{host-name}" },
        { "type": "os", "key": "OS:", "format": "{name}" },
        { "type": "packages", "key": "Packages:", "format": "{all}" },
        { "type": "shell", "key": "Shell:", "format": "{pretty-name}" },
        { "type": "wm", "key": "WM:", "format": "{pretty-name}" },
        { "type": "terminal", "key": "Terminal:", "format": "{pretty-name}" },
        { "type": "memory", "key": "Memory:", "format": "{used} / {total}" }
    ]
}
